OPENAI_API_KEY=your_openai_api_key_here
# Image generation (all optional; invalid values stop the app at startup).
# IMAGE_MODEL: gpt-image-2.6-sunburst (default) | gpt-image-2.6-flare | gpt-image-2.5-sunburst (rollback)
IMAGE_MODEL=
# IMAGE_QUALITY: medium (default) | high
IMAGE_QUALITY=
# IMAGE_CANVAS_PROFILE: experimental (default, up to 3840x2160 pixels) | stable (up to 2560x1440)
IMAGE_CANVAS_PROFILE=
# IMAGE_COMPLEXITY: low | medium | high. 2.6 models only; leave empty for the provider default (high).
IMAGE_COMPLEXITY=
# FABRIC_TREATMENT_DEFAULT: legacy-crop (default) | full-swatch | full-detail
FABRIC_TREATMENT_DEFAULT=

# Private staff authentication. Generate the encoded user allowlist with:
# npm run auth:create-user -- showroom "Showroom Staff"
AUTH_SESSION_SECRET=replace_with_at_least_32_random_characters
AUTH_USERS_JSON_BASE64=replace_with_generated_base64_allowlist
# Allowlist entries default to role "staff" and can read only their own history.
# Grant role "admin" explicitly for cross-account access. Increment authVersion
# (a string, e.g. "2") to revoke every session for an account without a password change.
# Password, role and authVersion changes all invalidate previous sessions.
AUTH_SESSION_TTL_HOURS=12
# Session cookies are browser-session-only by default. Set true only if a
# deliberate persistent sign-in policy is wanted.
AUTH_SESSION_PERSISTENT=false
AUTH_LOGIN_RATE_LIMIT_PER_15_MINUTES=10
# When testing from an iPhone/iPad on the same Wi-Fi, set this to the Mac's LAN IP.
DEV_ALLOWED_ORIGIN=192.168.1.115

# Required in production for serverless-safe rate limiting.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Required by the existing private catalogue and full-resolution image paths.
# These document existing runtime settings; never make the bucket public.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_private_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Required for permanent high-resolution generation history. Connect a
# Vercel-managed Neon database to populate this automatically in production.
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require

# Retain completed generations for 30 days by default (integer 1–365).
# Expired records are hidden immediately; the protected cleanup cron erases assets.
GENERATION_RETENTION_DAYS=30

# Protects the daily cleanup of abandoned uploads and retained generations. Vercel Cron sends this
# automatically; without it the cleanup route stays closed.
CRON_SECRET=replace_with_a_long_random_value

# Optional canonical production URL for social previews
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional server-side controls
TRY_ON_PROVIDER=openai
# Studio 4K always uses medium effort. This is retained only as documentation;
# the provider does not accept a per-request quality override.
TRY_ON_QUALITY=medium
TRYON_RATE_LIMIT_PER_MINUTE=2
TRYON_RATE_LIMIT_PER_HOUR=10
TRYON_RATE_LIMIT_PER_DAY=30
TRYON_GLOBAL_RATE_LIMIT_PER_DAY=50
# Legacy Redis History fallback only. Neon provides permanent paginated history.
TRYON_HISTORY_MAX_EVENTS=1000

# Optional comma-separated extra trusted origins. Normally leave unset because
# the deployed request host is accepted automatically.
# AUTH_ALLOWED_ORIGINS=https://tryon.nasirbespoke.com
