{
  "name": "nasir-bespoke-virtual-try-on",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "dev:next": "next dev",
    "build:next": "next build --webpack",
    "start:next": "next start",
    "test": "npm run test:security && npm run test:catalog && npm run test:bespoke && npm run test:render",
    "test:security": "NODE_ENV=test NODE_OPTIONS=--conditions=react-server node --import=tsx --test tests/security.test.ts tests/generation-guard.test.ts",
    "test:catalog": "NODE_ENV=test NODE_OPTIONS=--conditions=react-server node --import=tsx --test tests/catalog.test.ts",
    "test:bespoke": "NODE_ENV=test NODE_OPTIONS=--conditions=react-server node --import=tsx --test tests/bespoke.test.ts",
    "test:render": "node --test tests/rendered-html.test.mjs",
    "auth:create-user": "node scripts/hash-password.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "next": "16.3.0",
    "openai": "7.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
